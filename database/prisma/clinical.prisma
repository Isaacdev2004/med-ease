// ─────────────────────────────────────────────────────────────────────────────
// Clinical schema — patients (Epic 3 / P1)
// ─────────────────────────────────────────────────────────────────────────────

model Patient {
  id                String        @id @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  facilityId        String?       @map("facility_id") @db.Uuid
  userId            String?       @map("user_id") @db.Uuid
  mrn               String
  fullName          String        @map("full_name")
  dateOfBirth       DateTime      @map("date_of_birth") @db.Date
  gender            Gender?
  status            PatientStatus @default(active)
  primaryProviderId String?       @map("primary_provider_id") @db.Uuid
  fhirResourceId    String        @map("fhir_resource_id") @db.Uuid
  createdBy         String        @map("created_by") @db.Uuid
  updatedBy         String?       @map("updated_by") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")
  version           Int           @default(1)

  identifiers       PatientIdentifier[]
  contacts          PatientContact[]
  addresses         PatientAddress[]
  emergencyContacts PatientEmergencyContact[]
  allergies         PatientAllergy[]
  preferences       PatientPreference?
  appointments      Appointment[]
  prescriptions     Prescription[]
  medications       PatientMedication[]
  bedAssignments    BedAssignment[]
  admissions        Admission[]
  transfers         PatientTransfer[]
  carePlans         CarePlan[]
  labOrders         LabOrder[]
  radiologyOrders   RadiologyOrder[]
  radiologyStudies  RadiologyStudy[]
  monitoringVitals         MonitoringVital[]
  monitoringObservations   MonitoringObservation[]
  monitoringAlerts         MonitoringAlert[]
  monitoringPrograms       MonitoringProgram[]
  earlyWarningScores       EarlyWarningScore[]
  deviceAssignments        DeviceAssignment[]

  @@unique([tenantId, mrn])
  @@index([tenantId, status])
  @@index([tenantId, fullName])
  @@index([tenantId, facilityId])
  @@index([tenantId, deletedAt])
  @@map("patients")
  @@schema("clinical")
}

model PatientIdentifier {
  id         String                @id @db.Uuid
  tenantId   String                @map("tenant_id") @db.Uuid
  patientId  String                @map("patient_id") @db.Uuid
  type       PatientIdentifierType
  value      String
  system     String?
  isPrimary  Boolean               @default(false) @map("is_primary")
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type, value])
  @@index([patientId])
  @@map("patient_identifiers")
  @@schema("clinical")
}

model PatientContact {
  id        String             @id @db.Uuid
  tenantId  String             @map("tenant_id") @db.Uuid
  patientId String             @map("patient_id") @db.Uuid
  type      PatientContactType
  value     String
  isPrimary Boolean            @default(false) @map("is_primary")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([tenantId, value])
  @@map("patient_contacts")
  @@schema("clinical")
}

model PatientAddress {
  id         String             @id @db.Uuid
  tenantId   String             @map("tenant_id") @db.Uuid
  patientId  String             @map("patient_id") @db.Uuid
  type       PatientAddressType @default(home)
  street     String
  city       String
  state      String?
  postalCode String             @map("postal_code")
  country    String
  isPrimary  Boolean            @default(false) @map("is_primary")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_addresses")
  @@schema("clinical")
}

model PatientEmergencyContact {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  patientId    String   @map("patient_id") @db.Uuid
  name         String
  relationship String
  phone        String
  email        String?
  isPrimary    Boolean  @default(true) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_emergency_contacts")
  @@schema("clinical")
}

model PatientAllergy {
  id         String          @id @db.Uuid
  tenantId   String          @map("tenant_id") @db.Uuid
  patientId  String          @map("patient_id") @db.Uuid
  allergen   String
  type       AllergyType
  severity   AllergySeverity
  reaction   String?
  notedAt    DateTime        @default(now()) @map("noted_at")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([tenantId, allergen])
  @@map("patient_allergies")
  @@schema("clinical")
}

model PatientPreference {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  patientId     String   @unique @map("patient_id") @db.Uuid
  language      String   @default("en-US")
  maritalStatus String?  @map("marital_status")
  occupation    String?
  nationality   String?
  smoking       String?
  communication Json?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("patient_preferences")
  @@schema("clinical")
}

model Appointment {
  id                 String            @id @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  facilityId         String            @map("facility_id") @db.Uuid
  patientId          String            @map("patient_id") @db.Uuid
  providerId         String            @map("provider_id") @db.Uuid
  scheduledAt        DateTime          @map("scheduled_at") @db.Timestamptz(3)
  durationMinutes    Int               @default(30) @map("duration_minutes")
  status             AppointmentStatus @default(scheduled)
  visitType          String            @map("visit_type")
  referralId         String?           @map("referral_id") @db.Uuid
  telehealthLink     String?           @map("telehealth_link")
  notes              String?
  fhirResourceId     String            @map("fhir_resource_id") @db.Uuid
  specialty          String?
  department         String?
  room               String?
  reason             String?
  insurance          String?
  priority           String            @default("routine")
  checkInStatus      String            @default("not_checked_in") @map("check_in_status")
  queuePosition      Int?              @map("queue_position")
  followUpRequired   Boolean           @default(false) @map("follow_up_required")
  isRecurring        Boolean           @default(false) @map("is_recurring")
  recurringPattern   String?           @map("recurring_pattern")
  patientFullName    String            @map("patient_full_name")
  patientMrn         String            @map("patient_mrn")
  providerFullName   String            @map("provider_full_name")
  providerSpecialty  String?           @map("provider_specialty")
  providerDepartment String?           @map("provider_department")
  facilityName       String            @map("facility_name")
  facilityAddress    String?           @map("facility_address")
  createdBy          String            @map("created_by") @db.Uuid
  updatedBy          String?           @map("updated_by") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  version            Int               @default(1)

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([tenantId, facilityId, scheduledAt])
  @@index([tenantId, providerId, scheduledAt])
  @@index([tenantId, patientId, scheduledAt(sort: Desc)])
  @@map("appointments")
  @@schema("clinical")
}

// ─────────────────────────────────────────────────────────────────────────────
// Medications / Virtual Pill Organizer (Epic 3 / P0)
// ─────────────────────────────────────────────────────────────────────────────

model Prescription {
  id                      String             @id @db.Uuid
  tenantId                String             @map("tenant_id") @db.Uuid
  patientId               String             @map("patient_id") @db.Uuid
  prescriptionNumber      String             @map("prescription_number")
  patientName             String             @map("patient_name")
  medicationName          String             @map("medication_name")
  genericName             String             @map("generic_name")
  brandName               String?            @map("brand_name")
  strength                String
  medicationClass         String             @default("") @map("medication_class")
  medicationType          String             @default("") @map("medication_type")
  manufacturer            String?
  controlledSubstance     Boolean            @default(false) @map("controlled_substance")
  dose                    String
  frequency               String
  route                   MedicationRoute    @default(oral)
  durationDays            Int                @map("duration_days")
  startDate               DateTime           @map("start_date") @db.Date
  endDate                 DateTime?          @map("end_date") @db.Date
  validityDays            Int                @default(90) @map("validity_days")
  expiresAt               DateTime           @map("expires_at") @db.Timestamptz(3)
  status                  PrescriptionStatus @default(active)
  refillCount             Int                @default(0) @map("refill_count")
  refillsRemaining        Int                @default(0) @map("refills_remaining")
  prescribingPhysician    String             @map("prescribing_physician")
  prescribingPhysicianId  String             @map("prescribing_physician_id") @db.Uuid
  dispensingPharmacy      String?            @map("dispensing_pharmacy")
  dispensingPharmacyId    String?            @map("dispensing_pharmacy_id") @db.Uuid
  instructions            String             @default("")
  warnings                String[]           @default([])
  contraindications       String[]           @default([])
  isRecurring             Boolean            @default(false) @map("is_recurring")
  carePlanId              String?            @map("care_plan_id") @db.Uuid
  diagnosisCode           String?            @map("diagnosis_code")
  appointmentId           String?            @map("appointment_id") @db.Uuid
  facilityId              String?            @map("facility_id") @db.Uuid
  fhirResourceId          String             @map("fhir_resource_id") @db.Uuid
  createdBy               String             @map("created_by") @db.Uuid
  updatedBy               String?            @map("updated_by") @db.Uuid
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")
  version                 Int                @default(1)

  patient       Patient             @relation(fields: [patientId], references: [id])
  medications   PatientMedication[]
  refillRequests RefillRequest[]

  @@unique([tenantId, prescriptionNumber])
  @@index([tenantId, patientId, status])
  @@index([tenantId, status])
  @@map("prescriptions")
  @@schema("clinical")
}

model PatientMedication {
  id                     String           @id @db.Uuid
  tenantId               String           @map("tenant_id") @db.Uuid
  prescriptionId         String           @map("prescription_id") @db.Uuid
  patientId              String           @map("patient_id") @db.Uuid
  name                   String
  genericName            String           @map("generic_name")
  brandName              String?          @map("brand_name")
  strength               String
  medicationClass        String           @default("") @map("medication_class")
  medicationType         String           @default("") @map("medication_type")
  manufacturer           String?
  controlledSubstance    Boolean          @default(false) @map("controlled_substance")
  status                 MedicationStatus @default(active)
  dose                   String
  frequency              String
  route                  MedicationRoute  @default(oral)
  startDate              DateTime         @map("start_date") @db.Date
  endDate                DateTime?        @map("end_date") @db.Date
  remainingDays          Int?             @map("remaining_days")
  instructions           String           @default("")
  warnings               String[]         @default([])
  contraindications      String[]         @default([])
  sideEffects            String[]         @default([])
  storage                String?
  prescribingPhysician   String           @map("prescribing_physician")
  dispensingPharmacy     String?          @map("dispensing_pharmacy")
  refillCount            Int              @default(0) @map("refill_count")
  refillsRemaining       Int              @default(0) @map("refills_remaining")
  adherencePercent       Float            @default(100) @map("adherence_percent")
  condition              String?
  carePlanId             String?          @map("care_plan_id") @db.Uuid
  libraryMedicationId    String?          @map("library_medication_id") @db.Uuid
  createdBy              String           @map("created_by") @db.Uuid
  updatedBy              String?          @map("updated_by") @db.Uuid
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")
  version                Int              @default(1)

  patient      Patient        @relation(fields: [patientId], references: [id])
  prescription Prescription   @relation(fields: [prescriptionId], references: [id])
  doses        MedicationDose[]
  doseLogs     DoseLog[]
  reminders    MedicationReminder[]
  refillRequests RefillRequest[]

  @@index([tenantId, patientId, status])
  @@index([tenantId, prescriptionId])
  @@map("patient_medications")
  @@schema("clinical")
}

model MedicationDose {
  id             String              @id @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  medicationId   String              @map("medication_id") @db.Uuid
  patientId      String              @map("patient_id") @db.Uuid
  medicationName String              @map("medication_name")
  scheduledAt    DateTime            @map("scheduled_at") @db.Timestamptz(3)
  slot           ScheduleSlot        @default(morning)
  dose           String
  status         ScheduledDoseStatus @default(pending)
  instructions   String?

  medication PatientMedication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  doseLogs   DoseLog[]

  @@index([tenantId, patientId, scheduledAt])
  @@index([tenantId, medicationId, scheduledAt])
  @@map("medication_doses")
  @@schema("clinical")
}

model DoseLog {
  id              String        @id @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  medicationId    String        @map("medication_id") @db.Uuid
  patientId       String        @map("patient_id") @db.Uuid
  scheduledDoseId String?       @map("scheduled_dose_id") @db.Uuid
  status          DoseLogStatus
  loggedAt        DateTime      @map("logged_at") @db.Timestamptz(3)
  notes           String?
  symptoms        String?
  sideEffects     String?       @map("side_effects")
  mood            String?
  painScore       Int?          @map("pain_score")
  bloodSugar      Float?        @map("blood_sugar")
  bloodPressure   String?       @map("blood_pressure")
  temperature     Float?
  weight          Float?

  medication    PatientMedication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  scheduledDose MedicationDose?   @relation(fields: [scheduledDoseId], references: [id], onDelete: SetNull)

  @@index([tenantId, patientId, loggedAt(sort: Desc)])
  @@index([tenantId, medicationId, loggedAt(sort: Desc)])
  @@map("dose_logs")
  @@schema("clinical")
}

model MedicationReminder {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  medicationId String   @map("medication_id") @db.Uuid
  patientId    String   @map("patient_id") @db.Uuid
  type         String
  channel      String   @default("in_app")
  title        String
  message      String
  dueAt        DateTime @map("due_at") @db.Timestamptz(3)
  active       Boolean  @default(true)

  medication PatientMedication @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  @@index([tenantId, patientId, dueAt])
  @@index([tenantId, active, dueAt])
  @@map("medication_reminders")
  @@schema("clinical")
}

model RefillRequest {
  id               String              @id @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  prescriptionId   String              @map("prescription_id") @db.Uuid
  medicationId     String              @map("medication_id") @db.Uuid
  patientId        String              @map("patient_id") @db.Uuid
  patientName      String              @map("patient_name")
  medicationName   String              @map("medication_name")
  pharmacyId       String              @map("pharmacy_id") @db.Uuid
  pharmacyName     String              @map("pharmacy_name")
  status           RefillRequestStatus @default(pending)
  remainingTablets Int?                @map("remaining_tablets")
  daysLeft         Int?                @map("days_left")
  requestedAt      DateTime            @default(now()) @map("requested_at") @db.Timestamptz(3)
  expectedDate     DateTime?           @map("expected_date") @db.Date
  autoRefill       Boolean             @default(false) @map("auto_refill")
  createdBy        String              @map("created_by") @db.Uuid
  updatedBy        String?             @map("updated_by") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  prescription Prescription     @relation(fields: [prescriptionId], references: [id])
  medication   PatientMedication @relation(fields: [medicationId], references: [id])

  @@index([tenantId, patientId, status])
  @@index([tenantId, prescriptionId])
  @@map("refill_requests")
  @@schema("clinical")
}

// ─────────────────────────────────────────────────────────────────────────────
// Beds / bed board (Epic 3 / P0)
// ─────────────────────────────────────────────────────────────────────────────

model Bed {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  facilityId    String    @map("facility_id") @db.Uuid
  facilityName  String    @map("facility_name")
  label         String
  ward          String
  roomLabel     String    @map("room_label")
  bedType       String    @default("standard") @map("bed_type")
  status        BedStatus @default(available)
  patientId     String?   @map("patient_id") @db.Uuid
  patientName   String?   @map("patient_name")
  reservedUntil DateTime? @map("reserved_until") @db.Timestamptz(3)
  notes         String?
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String?   @map("updated_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  version       Int       @default(1)

  assignments BedAssignment[]
  admissions  Admission[]

  @@unique([tenantId, facilityId, label])
  @@index([tenantId, facilityId, status])
  @@index([tenantId, ward, status])
  @@index([tenantId, patientId])
  @@map("beds")
  @@schema("clinical")
}

model BedAssignment {
  id           String              @id @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  bedId        String              @map("bed_id") @db.Uuid
  patientId    String              @map("patient_id") @db.Uuid
  patientName  String              @map("patient_name")
  status       BedAssignmentStatus @default(assigned)
  assignedAt   DateTime            @default(now()) @map("assigned_at") @db.Timestamptz(3)
  releasedAt   DateTime?           @map("released_at") @db.Timestamptz(3)
  assignedBy   String              @map("assigned_by") @db.Uuid
  releasedBy   String?             @map("released_by") @db.Uuid
  notes        String?

  bed     Bed      @relation(fields: [bedId], references: [id], onDelete: Cascade)
  patient Patient  @relation(fields: [patientId], references: [id])

  @@index([tenantId, bedId, assignedAt(sort: Desc)])
  @@index([tenantId, patientId, status])
  @@map("bed_assignments")
  @@schema("clinical")
}

// ─────────────────────────────────────────────────────────────────────────────
// Admissions / transfers (Epic 3 / P0)
// ─────────────────────────────────────────────────────────────────────────────

model Admission {
  id            String            @id @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  patientId     String            @map("patient_id") @db.Uuid
  patientName   String            @map("patient_name")
  patientMrn    String            @map("patient_mrn")
  facilityId    String            @map("facility_id") @db.Uuid
  facilityName  String            @map("facility_name")
  ward          String
  bedId         String?           @map("bed_id") @db.Uuid
  bedLabel      String?           @map("bed_label")
  status        AdmissionStatus   @default(requested)
  priority      AdmissionPriority @default(routine)
  reason        String?
  requestedAt   DateTime          @default(now()) @map("requested_at") @db.Timestamptz(3)
  triagedAt     DateTime?         @map("triaged_at") @db.Timestamptz(3)
  admittedAt    DateTime?         @map("admitted_at") @db.Timestamptz(3)
  dischargedAt  DateTime?         @map("discharged_at") @db.Timestamptz(3)
  cancelledAt   DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  notes         String?
  createdBy     String            @map("created_by") @db.Uuid
  updatedBy     String?           @map("updated_by") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  version       Int               @default(1)

  patient   Patient            @relation(fields: [patientId], references: [id])
  bed       Bed?               @relation(fields: [bedId], references: [id], onDelete: SetNull)
  transfers PatientTransfer[]

  @@index([tenantId, facilityId, status])
  @@index([tenantId, patientId, status])
  @@index([tenantId, status, requestedAt(sort: Desc)])
  @@map("admissions")
  @@schema("clinical")
}

model PatientTransfer {
  id               String         @id @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  admissionId      String?        @map("admission_id") @db.Uuid
  patientId        String         @map("patient_id") @db.Uuid
  patientName      String         @map("patient_name")
  fromFacilityId   String         @map("from_facility_id") @db.Uuid
  fromFacilityName String         @map("from_facility_name")
  fromWard         String         @map("from_ward")
  fromBedId        String?        @map("from_bed_id") @db.Uuid
  toFacilityId     String         @map("to_facility_id") @db.Uuid
  toFacilityName   String         @map("to_facility_name")
  toWard           String         @map("to_ward")
  toBedId          String?        @map("to_bed_id") @db.Uuid
  toBedLabel       String?        @map("to_bed_label")
  status           TransferStatus @default(requested)
  reason           String?
  requestedAt      DateTime       @default(now()) @map("requested_at") @db.Timestamptz(3)
  approvedAt       DateTime?      @map("approved_at") @db.Timestamptz(3)
  startedAt        DateTime?      @map("started_at") @db.Timestamptz(3)
  completedAt      DateTime?      @map("completed_at") @db.Timestamptz(3)
  cancelledAt      DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  notes            String?
  createdBy        String         @map("created_by") @db.Uuid
  updatedBy        String?        @map("updated_by") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  version          Int            @default(1)

  patient   Patient    @relation(fields: [patientId], references: [id])
  admission Admission? @relation(fields: [admissionId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, requestedAt(sort: Desc)])
  @@index([tenantId, patientId, status])
  @@index([tenantId, admissionId])
  @@map("patient_transfers")
  @@schema("clinical")
}

// ─────────────────────────────────────────────────────────────────────────────
// Care pathways / enrollments (Epic 3 / P0)
// ─────────────────────────────────────────────────────────────────────────────

model CarePathwayDefinition {
  id                   String   @id @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  code                 String
  name                 String
  description          String   @default("")
  completionCriteria   String   @default("") @map("completion_criteria")
  requiredAppointments Int      @default(0) @map("required_appointments")
  requiredLabs         Int      @default(0) @map("required_labs")
  medicationProtocols  String[] @default([]) @map("medication_protocols")
  mandatoryTasks       String[] @default([]) @map("mandatory_tasks")
  active               Boolean  @default(true)
  createdBy            String   @map("created_by") @db.Uuid
  updatedBy            String?  @map("updated_by") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  steps       CarePathwayStepDefinition[]
  enrollments CarePlan[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@map("care_pathway_definitions")
  @@schema("clinical")
}

model CarePathwayStepDefinition {
