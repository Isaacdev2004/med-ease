  unassignedAt DateTime? @map("unassigned_at") @db.Timestamptz(3)
  programId    String?   @map("program_id") @db.Uuid
  active       Boolean   @default(true)

  device  MonitoringDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  patient Patient          @relation(fields: [patientId], references: [id])

  @@index([tenantId, patientId, active])
  @@index([tenantId, deviceId])
  @@map("device_assignments")
  @@schema("clinical")
}

model MonitoringVital {
  id           String            @id @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  patientId    String            @map("patient_id") @db.Uuid
  type         VitalType
  valueText    String            @map("value_text")
  valueNumeric Float?            @map("value_numeric")
  unit         String            @default("")
  recordedAt   DateTime          @map("recorded_at") @db.Timestamptz(3)
  context      MonitoringContext @default(home)
  deviceId     String?           @map("device_id") @db.Uuid
  recordedBy   String?           @map("recorded_by")
  status       VitalStatus       @default(normal)
  systolic     Int?
  diastolic    Int?
  createdAt    DateTime          @default(now()) @map("created_at")

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([tenantId, patientId, recordedAt(sort: Desc)])
  @@index([tenantId, type, recordedAt(sort: Desc)])
  @@map("vital_signs")
  @@schema("clinical")
}

model MonitoringObservation {
  id               String                       @id @db.Uuid
  tenantId         String                       @map("tenant_id") @db.Uuid
  patientId        String                       @map("patient_id") @db.Uuid
  category         String                       @default("vital-signs")
  code             String
  display          String
  valueText        String                       @map("value_text")
  valueNumeric     Float?                       @map("value_numeric")
  unit             String                       @default("")
  recordedAt       DateTime                     @map("recorded_at") @db.Timestamptz(3)
  context          MonitoringContext            @default(home)
  deviceId         String?                      @map("device_id") @db.Uuid
  sessionId        String?                      @map("session_id") @db.Uuid
  status           MonitoringObservationStatus  @default(final)
  interpretation   MonitoringInterpretation?
  referenceRange   String?                      @map("reference_range")
  recordedBy       String?                      @map("recorded_by")
  notes            String?
  carePlanId       String?                      @map("care_plan_id") @db.Uuid
  appointmentId    String?                      @map("appointment_id") @db.Uuid
  createdBy        String                       @map("created_by") @db.Uuid
  updatedBy        String?                      @map("updated_by") @db.Uuid
  createdAt        DateTime                     @default(now()) @map("created_at")
  updatedAt        DateTime                     @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([tenantId, patientId, recordedAt(sort: Desc)])
  @@index([tenantId, category, recordedAt(sort: Desc)])
  @@map("monitoring_observations")
  @@schema("clinical")
}

model MonitoringAlert {
  id               String                @id @db.Uuid
  tenantId         String                @map("tenant_id") @db.Uuid
  patientId        String                @map("patient_id") @db.Uuid
  patientName      String                @map("patient_name")
  type             MonitoringAlertType
  severity         AlertSeverity         @default(warning)
  status           MonitoringAlertStatus @default(active)
  title            String
  message          String                @default("")
  metric           VitalType?
  valueText        String?               @map("value_text")
  threshold        String?
  acknowledgedAt   DateTime?             @map("acknowledged_at") @db.Timestamptz(3)
  acknowledgedBy   String?               @map("acknowledged_by")
  resolvedAt       DateTime?             @map("resolved_at") @db.Timestamptz(3)
  observationId    String?               @map("observation_id") @db.Uuid
  deviceId         String?               @map("device_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([tenantId, patientId, status])
  @@index([tenantId, status, severity, createdAt(sort: Desc)])
  @@map("monitoring_alerts")
  @@schema("clinical")
}

model MonitoringProgram {
  id             String           @id @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  patientId      String           @map("patient_id") @db.Uuid
  name           String
  status         RpmProgramStatus @default(active)
  enrolledAt     DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz(3)
  enrolledBy     String           @map("enrolled_by")
  deviceIds      String[]         @default([]) @map("device_ids")
  metrics        String[]         @default([])
  frequency      String           @default("")
  clinicianId    String           @map("clinician_id") @db.Uuid
  clinicianName  String           @map("clinician_name")
  carePlanId     String?          @map("care_plan_id") @db.Uuid
  completedAt    DateTime?        @map("completed_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([tenantId, patientId, status])
  @@map("monitoring_programs")
  @@schema("clinical")
}

model EarlyWarningScore {
  id            String            @id @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  patientId     String            @map("patient_id") @db.Uuid
  type          EarlyWarningType
  score         Int
  riskLevel     EarlyWarningRisk  @map("risk_level")
  components    Json              @default("{}")
  calculatedAt  DateTime          @map("calculated_at") @db.Timestamptz(3)
  context       MonitoringContext @default(ward)
  createdAt     DateTime          @default(now()) @map("created_at")

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([tenantId, patientId, calculatedAt(sort: Desc)])
  @@map("early_warning_scores")
  @@schema("clinical")
}
