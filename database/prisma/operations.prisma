// ─────────────────────────────────────────────────────────────────────────────
// Operations schema — inventory (Epic 5 MVP)
// ─────────────────────────────────────────────────────────────────────────────

model Warehouse {
  id                  String   @id @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  facilityId          String   @map("facility_id") @db.Uuid
  name                String
  code                String
  address             String   @default("")
  capacity            Int      @default(0)
  utilizationPercent  Int      @default(0) @map("utilization_percent")
  zones               String[] @default([])
  managerName         String   @default("") @map("manager_name")
  status              String   @default("active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  items InventoryItem[]

  @@unique([tenantId, code])
  @@index([tenantId, facilityId])
  @@map("warehouses")
  @@schema("operations")
}

model InventoryItem {
  id                 String               @id @db.Uuid
  tenantId           String               @map("tenant_id") @db.Uuid
  warehouseId        String               @map("warehouse_id") @db.Uuid
  facilityId         String               @map("facility_id") @db.Uuid
  sku                String
  barcode            String               @default("")
  itemName           String               @map("item_name")
  genericName        String?              @map("generic_name")
  category           InventoryCategory    @default(supplies)
  department         InventoryDepartment  @default(general)
  manufacturer       String               @default("")
  supplierName       String               @default("") @map("supplier_name")
  unit               String               @default("ea")
  packageSize        Int                  @default(1) @map("package_size")
  purchasePriceCents BigInt               @default(0) @map("purchase_price_cents")
  sellingPriceCents  BigInt               @default(0) @map("selling_price_cents")
  quantityOnHand     Int                  @default(0) @map("quantity_on_hand")
  reservedQuantity   Int                  @default(0) @map("reserved_quantity")
  reorderLevel       Int                  @default(0) @map("reorder_level")
  reorderQuantity    Int                  @default(0) @map("reorder_quantity")
  maximumStock       Int                  @default(0) @map("maximum_stock")
  minimumStock       Int                  @default(0) @map("minimum_stock")
  expiryDate         DateTime?            @map("expiry_date") @db.Date
  batchNumber        String?              @map("batch_number")
  storageConditions  String               @default("") @map("storage_conditions")
  shelfLocation      String               @default("") @map("shelf_location")
  status             InventoryItemStatus  @default(active)
  coldChain          Boolean              @default(false) @map("cold_chain")
  createdBy          String               @map("created_by") @db.Uuid
  updatedBy          String?              @map("updated_by") @db.Uuid
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  movements StockMovement[]
  poLines   PurchaseOrderLine[]

  @@unique([tenantId, sku])
  @@index([tenantId, facilityId, status])
  @@index([tenantId, warehouseId, category])
  @@index([tenantId, department, status])
  @@map("inventory_items")
  @@schema("operations")
}

model Supplier {
  id                  String   @id @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  name                String
  contactEmail        String   @default("") @map("contact_email")
  contactPhone        String   @default("") @map("contact_phone")
  address             String   @default("")
  rating              Float    @default(0)
  onTimeDeliveryRate  Int      @default(0) @map("on_time_delivery_rate")
  totalOrders         Int      @default(0) @map("total_orders")
  categories          InventoryCategory[] @default([])
  status              String   @default("active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  purchaseOrders PurchaseOrder[]

  @@index([tenantId, status])
  @@index([tenantId, name])
  @@map("suppliers")
  @@schema("operations")
}

model PurchaseOrder {
  id               String              @id @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  facilityId       String?             @map("facility_id") @db.Uuid
  supplierId       String              @map("supplier_id") @db.Uuid
  poNumber         String              @map("po_number")
  department       InventoryDepartment @default(general)
  status           PurchaseOrderStatus @default(draft)
  subtotalCents    BigInt              @default(0) @map("subtotal_cents")
  taxCents         BigInt              @default(0) @map("tax_cents")
  totalCents       BigInt              @default(0) @map("total_cents")
  requestedBy      String              @map("requested_by")
  approvedBy       String?             @map("approved_by")
  orderDate        DateTime?           @map("order_date")
  expectedDelivery DateTime?           @map("expected_delivery")
  receivedDate     DateTime?           @map("received_date")
  createdBy        String              @map("created_by") @db.Uuid
  updatedBy        String?             @map("updated_by") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  supplier Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]

  @@unique([tenantId, poNumber])
  @@index([tenantId, status])
  @@index([tenantId, supplierId])
  @@index([tenantId, department, status])
  @@map("purchase_orders")
  @@schema("operations")
}

model PurchaseOrderLine {
  id               String @id @db.Uuid
  tenantId         String @map("tenant_id") @db.Uuid
  purchaseOrderId  String @map("purchase_order_id") @db.Uuid
  inventoryId      String? @map("inventory_id") @db.Uuid
  sku              String
  itemName         String @map("item_name")
  quantity         Int
  unitPriceCents   BigInt @map("unit_price_cents")
  receivedQuantity Int    @default(0) @map("received_quantity")
  sortOrder        Int    @default(0) @map("sort_order")

  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryId], references: [id], onDelete: SetNull)

  @@index([tenantId, purchaseOrderId])
  @@map("purchase_order_lines")
  @@schema("operations")
}

model StockMovement {
  id           String            @id @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  inventoryId  String            @map("inventory_id") @db.Uuid
  itemName     String            @map("item_name")
  type         StockMovementType
  quantity     Int
  fromLocation String?           @map("from_location")
  toLocation   String?           @map("to_location")
  reference    String?
  performedBy  String            @map("performed_by")
  notes        String?
  createdBy    String            @map("created_by") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at")

  item InventoryItem @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([tenantId, inventoryId, createdAt(sort: Desc)])
  @@index([tenantId, type, createdAt(sort: Desc)])
  @@map("stock_movements")
  @@schema("operations")
}

model Rfq {
  id                 String    @id @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  rfqNumber          String    @map("rfq_number")
  title              String
  department         String    @default("general")
  status             RfqStatus @default(draft)
  requisitionId      String?   @map("requisition_id") @db.Uuid
  deadline           DateTime
  awardedSupplierId  String?   @map("awarded_supplier_id") @db.Uuid
  invitedSupplierIds String[]  @default([]) @map("invited_supplier_ids")
  createdBy          String    @map("created_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  lines     RfqLine[]
  responses RfqResponse[]

  @@unique([tenantId, rfqNumber])
  @@index([tenantId, status])
  @@index([tenantId, department, status])
  @@map("rfqs")
  @@schema("operations")
}

model RfqLine {
  id             String  @id @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  rfqId          String  @map("rfq_id") @db.Uuid
  description    String
  quantity       Int
  unit           String  @default("ea")
  specifications String?
  sortOrder      Int     @default(0) @map("sort_order")

  rfq Rfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@index([tenantId, rfqId])
  @@map("rfq_lines")
  @@schema("operations")
}

model RfqResponse {
  id            String            @id @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  rfqId         String            @map("rfq_id") @db.Uuid
  supplierId    String            @map("supplier_id") @db.Uuid
  supplierName  String            @map("supplier_name")
  totalQuoteCents BigInt          @map("total_quote_cents")
  currencyCode  String            @default("EUR") @map("currency_code") @db.Char(3)
  validUntil    DateTime          @map("valid_until")
  rank          Int?
  status        RfqResponseStatus @default(submitted)
  lineQuotes    Json              @map("line_quotes")
  submittedAt   DateTime          @default(now()) @map("submitted_at")

  rfq Rfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@index([tenantId, rfqId])
  @@index([tenantId, supplierId])
  @@map("rfq_responses")
  @@schema("operations")
}

model GoodsReceipt {
  id              String             @id @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  receiptNumber   String             @map("receipt_number")
  purchaseOrderId String             @map("purchase_order_id") @db.Uuid
  poNumber        String             @map("po_number")
  supplierId      String             @map("supplier_id") @db.Uuid
  warehouseId     String             @map("warehouse_id") @db.Uuid
  status          GoodsReceiptStatus @default(pending)
  receivedBy      String             @map("received_by")
  receivedAt      DateTime           @map("received_at")
  notes           String?
  createdBy       String             @map("created_by") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at")

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  lines         GoodsReceiptLine[]

  @@unique([tenantId, receiptNumber])
  @@index([tenantId, purchaseOrderId])
  @@index([tenantId, status])
  @@map("goods_receipts")
  @@schema("operations")
}

model GoodsReceiptLine {
  id          String @id @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  receiptId   String @map("receipt_id") @db.Uuid
  poLineId    String? @map("po_line_id") @db.Uuid
  description String
  orderedQty  Int    @map("ordered_qty")
  receivedQty Int    @map("received_qty")

  receipt GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([tenantId, receiptId])
  @@map("goods_receipt_lines")
  @@schema("operations")
}
